{
  "main": {
    "run_dir": "./runs",
    "jobname": "vae_full128_fidelity"
  },
  "training": {
    "batch_size": 32,
    "learning_rate": 0.0001,
    "epochs": 100,
    "num_workers": 8,
    "kl_weight": 1e-6,
    "perceptual_weight": 0.1,
    "adv_weight": 0.02,
    "log_interval": 1,
    "save_interval": 10,
    "val_interval": 5,
    "max_val_steps": 20,
    "recon_loss": "l1",
    "amp": true,
    "cache": 0.5,
    "seed": 42
  },
  "model": {
    "autoencoder": {
      "spatial_dims": 2,
      "in_channels": 1,
      "out_channels": 1,
      "latent_channels": 4,
      "num_channels": [64, 128, 256],
      "num_res_blocks": [2, 2, 2],
      "norm_num_groups": 32,
      "norm_eps": 1e-6,
      "attention_levels": [false, false, false],
      "with_encoder_nonlocal_attn": false,
      "with_decoder_nonlocal_attn": false,
      "use_checkpointing": false,
      "use_convtranspose": false,
      "norm_float16": true,
      "num_splits": 1,
      "dim_split": 1
    },
    "discriminator": {
      "spatial_dims": 2,
      "num_layers_d": 3,
      "channels": 32,
      "in_channels": 1,
      "out_channels": 1,
      "norm": "INSTANCE"
    }
  },
  "data": {
    "image_dir": "/media/user/Extreme SSD/Thesis/data/KermanyV3_resized/train",
    "train_transform": {
      "resize": [128, 128],
      "random_crop_scale": null,
      "random_flip_prob": 0.0,
      "random_rotation_angle": 0,
      "brightness_adjustment": 0.0,
      "contrast_adjustment": 0.0,
      "speckle_noise_std": 0.0
    },
    "val_transform": {
      "resize": [128, 128]
    }
  }
}
