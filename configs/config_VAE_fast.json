{
    "main": {
        "run_dir": "./runs",
        "jobname": "vae_fast64"
    },
    "training": {
        "batch_size": 16,
        "learning_rate": 1e-4,
        "epochs": 5,
        "num_workers": 8,
        "kl_weight": 1e-6,
        "perceptual_weight": 0.1,
        "adv_weight": 0.05,
        "log_interval": 1,
        "save_interval": 1,
        "val_interval": 1,
        "recon_loss": "l1",
        "amp": true,
        "cache": 0.0
    },
    "model": {
        "autoencoder": {
            "spatial_dims": 2,
            "in_channels": 1,
            "out_channels": 1,
            "latent_channels": 4,
            "num_channels": [32, 64, 128],
            "num_res_blocks": [1, 1, 1],
            "norm_num_groups": 16,
            "norm_eps": 1e-6,
            "attention_levels": [false, false, false],
            "with_encoder_nonlocal_attn": false,
            "with_decoder_nonlocal_attn": false,
            "use_checkpointing": false,
            "use_convtranspose": false,
            "norm_float16": true,
            "num_splits": 1,
            "dim_split": 1
        },
        "discriminator": {
            "spatial_dims": 2,
            "num_layers_d": 2,
            "channels": 16,
            "in_channels": 1,
            "out_channels": 1,
            "norm": "INSTANCE"
        }
    },
    "data": {
        "image_dir": "/home/user/Thesis/data/KermanyV3_resized/train",
        "train_transform": {
            "resize": [64, 64],
            "random_flip_prob": 0.5
        },
        "val_transform": {
            "resize": [64, 64]
        }
    }
}
